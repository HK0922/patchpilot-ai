# Demo mode needs no credentials. Read docs/SETUP.md before enabling live mode.
PATCHPILOT_DATA_DIR=.data
# OPENAI_API_KEY=replace-in-your-shell
# PATCHPILOT_MODEL=your-supported-structured-output-model
# PATCHPILOT_API_TOKEN=generate-a-long-random-value
# Optional estimates only; set rates to your current model price per 1M tokens.
# PATCHPILOT_INPUT_PRICE=0
# PATCHPILOT_OUTPUT_PRICE=0
PATCHPILOT_TEST_TIMEOUT=20
PATCHPILOT_MAX_RUN_SECONDS=240
PATCHPILOT_SANDBOX_IMAGE=patchpilot-sandbox:0.1
